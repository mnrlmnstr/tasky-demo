{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "description": "The body of a 404 or 500 response.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Page_TaskRead_": {
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/TaskRead"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "This page's number, from 1.",
            "examples": [
              1
            ],
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "The most items a page holds.",
            "examples": [
              20
            ],
            "title": "Page Size",
            "type": "integer"
          },
          "pages": {
            "description": "How many pages there are in all.",
            "examples": [
              3
            ],
            "title": "Pages",
            "type": "integer"
          },
          "total": {
            "description": "How many items match, across all pages.",
            "examples": [
              42
            ],
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "pages"
        ],
        "title": "Page[TaskRead]",
        "type": "object"
      },
      "TaskCreate": {
        "additionalProperties": false,
        "properties": {
          "deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the task is due, with a timezone; returned in UTC.",
            "examples": [
              "2026-12-01T17:00:00Z"
            ],
            "title": "Deadline"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Free-text details.",
            "examples": [
              "Collect the numbers from finance and draft the summary."
            ],
            "title": "Description"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority",
            "default": "medium",
            "description": "How urgent the task is.",
            "examples": [
              "high"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "default": "todo",
            "description": "Where the task stands.",
            "examples": [
              "todo"
            ]
          },
          "title": {
            "description": "What the task is, 1 to 200 characters; surrounding whitespace is trimmed.",
            "examples": [
              "Prepare the quarterly report"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskOrdering": {
        "description": "How a task list is sorted; a leading `-` means descending.",
        "enum": [
          "created_at",
          "-created_at",
          "deadline",
          "-deadline"
        ],
        "title": "TaskOrdering",
        "type": "string"
      },
      "TaskPriority": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "TaskPriority",
        "type": "string"
      },
      "TaskRead": {
        "properties": {
          "created_at": {
            "description": "When the task was created, in UTC.",
            "examples": [
              "2026-11-02T09:30:00Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the task is due, in UTC.",
            "examples": [
              "2026-12-01T17:00:00Z"
            ],
            "title": "Deadline"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Free-text details.",
            "examples": [
              "Collect the numbers from finance and draft the summary."
            ],
            "title": "Description"
          },
          "id": {
            "description": "The task's id.",
            "examples": [
              "3f2b8c1e-6d4a-4f7e-9a51-2c8d7e0b4a19"
            ],
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority",
            "description": "How urgent the task is.",
            "examples": [
              "medium"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "description": "Where the task stands.",
            "examples": [
              "in_progress"
            ]
          },
          "title": {
            "description": "What the task is.",
            "examples": [
              "Prepare the quarterly report"
            ],
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "description": "When the task last changed, in UTC.",
            "examples": [
              "2026-11-03T14:05:00Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "status",
          "priority",
          "deadline",
          "created_at",
          "updated_at"
        ],
        "title": "TaskRead",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "todo",
          "in_progress",
          "done"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskUpdate": {
        "additionalProperties": false,
        "description": "Only the fields sent are applied; title, status and priority can't be null.",
        "properties": {
          "deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the task is due, with a timezone; returned in UTC. Send `null` to clear it.",
            "examples": [
              "2026-12-01T17:00:00Z"
            ],
            "title": "Deadline"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Free-text details. Send `null` to clear it.",
            "examples": [
              "Collect the numbers from finance and draft the summary."
            ],
            "title": "Description"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority",
            "description": "How urgent the task is.",
            "examples": [
              "low"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "description": "Where the task stands.",
            "examples": [
              "done"
            ]
          },
          "title": {
            "description": "What the task is, 1 to 200 characters; surrounding whitespace is trimmed.",
            "examples": [
              "Prepare the quarterly report"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "TaskUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nA small task tracker: create, list, update and delete tasks.\n\nAll endpoints live under `/api/v1`.\n\n**Errors.** A missing task is a `404` with `{\"detail\": \"Task not found\"}`. A request that\nfails validation is a `422` whose `detail` lists the problems, one per field. Any other\nfailure is a `500` with `{\"detail\": \"Internal server error\"}`.\n\n**Soft delete.** Deleting a task hides it: it no longer appears in lists, and reading,\nupdating or deleting it again answers `404`.\n",
    "title": "Tasky API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "`200` with `{\"status\": \"ok\"}` when the database answers, otherwise `503` with\n`{\"status\": \"unavailable\"}`.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Gethealth",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Check health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "description": "One page of tasks, newest first unless `ordering` says otherwise. Filter by `status`\nand search titles with `search`. `deadline_from` (inclusive) and `deadline_to` (exclusive)\nkeep tasks due in that range and leave out tasks without a deadline; `deadline_from` after\n`deadline_to` answers `422`. Deleted tasks never appear.",
        "operationId": "listTasks",
        "parameters": [
          {
            "description": "Only tasks with this status.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TaskStatus",
              "description": "Only tasks with this status.",
              "examples": [
                "in_progress"
              ]
            }
          },
          {
            "description": "Only tasks whose title contains this text, ignoring case.",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "description": "Only tasks whose title contains this text, ignoring case.",
              "examples": [
                "\u0437\u0432\u0456\u0442"
              ],
              "title": "Search",
              "type": "string"
            }
          },
          {
            "description": "Only tasks due at or after this instant (inclusive), with a timezone. Tasks without a deadline are left out while either bound is set.",
            "in": "query",
            "name": "deadline_from",
            "required": false,
            "schema": {
              "description": "Only tasks due at or after this instant (inclusive), with a timezone. Tasks without a deadline are left out while either bound is set.",
              "examples": [
                "2026-11-19T22:00:00Z"
              ],
              "format": "date-time",
              "title": "Deadline From",
              "type": "string"
            }
          },
          {
            "description": "Only tasks due before this instant (exclusive), with a timezone; must not be before `deadline_from`.",
            "in": "query",
            "name": "deadline_to",
            "required": false,
            "schema": {
              "description": "Only tasks due before this instant (exclusive), with a timezone; must not be before `deadline_from`.",
              "examples": [
                "2026-11-20T22:00:00Z"
              ],
              "format": "date-time",
              "title": "Deadline To",
              "type": "string"
            }
          },
          {
            "description": "Sort by `created_at` or `deadline`; a leading `-` sorts descending. Tasks without a deadline come last either way.",
            "in": "query",
            "name": "ordering",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TaskOrdering",
              "default": "-created_at",
              "description": "Sort by `created_at` or `deadline`; a leading `-` sorts descending. Tasks without a deadline come last either way.",
              "examples": [
                "deadline"
              ]
            }
          },
          {
            "description": "Which page to return, from 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Which page to return, from 1.",
              "examples": [
                1
              ],
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "How many tasks per page (1 to 100).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "description": "How many tasks per page (1 to 100).",
              "examples": [
                20
              ],
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_TaskRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List tasks",
        "tags": [
          "tasks"
        ]
      },
      "post": {
        "description": "Create a task. Only `title` is required; status defaults to `todo` and priority to\n`medium`. A `deadline` must carry a timezone and is returned in UTC.",
        "operationId": "createTask",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "full": {
                  "summary": "A task with every field",
                  "value": {
                    "deadline": "2026-12-01T17:00:00Z",
                    "description": "Collect the numbers from finance and draft the summary.",
                    "priority": "high",
                    "status": "todo",
                    "title": "Prepare the quarterly report"
                  }
                },
                "minimal": {
                  "summary": "Only a title",
                  "value": {
                    "title": "Call the plumber"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create a task",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/tasks/{task_id}": {
      "delete": {
        "description": "Soft-delete a task: it is kept but hidden, so reading, updating or deleting it again\nanswers `404`.",
        "operationId": "deleteTask",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Task not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Delete a task",
        "tags": [
          "tasks"
        ]
      },
      "get": {
        "description": "The task with this id. A deleted task answers `404`.",
        "operationId": "getTask",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Task not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get a task",
        "tags": [
          "tasks"
        ]
      },
      "patch": {
        "description": "Change some fields of a task; fields left out keep their value. `title`, `status` and\n`priority` can't be set to null; send `null` for `description` or `deadline` to clear it.\nA deleted task answers `404`.",
        "operationId": "updateTask",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "change_status": {
                  "summary": "Change the status",
                  "value": {
                    "status": "done"
                  }
                },
                "clear_deadline": {
                  "summary": "Clear the deadline",
                  "value": {
                    "deadline": null
                  }
                },
                "several_fields": {
                  "summary": "Change several fields",
                  "value": {
                    "priority": "medium",
                    "title": "Prepare the annual report"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/TaskUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Task not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Update a task",
        "tags": [
          "tasks"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Create, list, read, update and delete tasks.",
      "name": "tasks"
    },
    {
      "description": "Whether the API and its database are up.",
      "name": "health"
    }
  ]
}
