{
  "name": "tasky-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "api:generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@vueuse/core": "^15.0.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "orval": "^8.48.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
