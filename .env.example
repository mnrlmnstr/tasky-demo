# Optional overrides for docker-compose.yml.
# `docker compose up` works without this file: every value below is the built-in default.
# To change something, copy this file to `.env` and edit the copy.

# Host ports. Change them if 8080 or 8000 is already taken on your machine.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# PostgreSQL credentials and database name. The database is not published to the host.
# They are applied when the database volume is first created; to change them later,
# reset the volume with `docker compose down -v`.
POSTGRES_USER=tasky
POSTGRES_PASSWORD=tasky
POSTGRES_DB=tasky

# Load demo tasks on start. Set to false to start with an empty database.
SEED_DEMO_DATA=true
